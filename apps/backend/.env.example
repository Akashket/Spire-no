# Kopier denne filen til .env og fyll inn ekte verdier. .env skal ALDRI committes (står i .gitignore).

# Postgres - matcher docker-compose.yml. Bruk "localhost" når backend kjører lokalt (utenfor docker),
# bruk "postgres" (tjenestenavnet) hvis backend selv kjører inne i docker-compose.
DATABASE_URL="postgresql://spire:spire@localhost:5432/spire?schema=public"

# JWT - MÅ byttes til lange, tilfeldige verdier før noe som helst går til produksjon.
# To ulike secrets for access- og refresh-token er bevisst: kompromitteres den ene, er ikke den andre brutt.
JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development

REDIS_URL="redis://localhost:6379"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="spire"
S3_SECRET_KEY="spire12345"
S3_BUCKET="spire-articles"

# Stripe (test mode - se README for steg-for-steg-oppsett av konto/nøkler).
# Stripe-SDK-en krever en ikke-tom nøkkel-streng allerede ved oppstart, derfor placeholder-verdier
# under (appen starter fint med disse - de feiler først når et faktisk Stripe-kall gjøres, f.eks.
# POST /subscriptions/checkout). Bytt til ekte test-nøkler når du skal teste betalingsflyten live.
STRIPE_SECRET_KEY="stripe_secret_key_not_set_yet"
STRIPE_WEBHOOK_SECRET="whsec_test_placeholder_replace_with_real_secret"
# Price ID for et recurring test-produkt, opprettet i Stripe Dashboard (Product catalog -> Add product)
STRIPE_PRICE_ID="price_placeholder_replace_with_real_price_id"

# Brukes til å bygge success_url/cancel_url for Stripe Checkout - peker til frontend (kommer senere)
FRONTEND_URL="http://localhost:3000"
